APP_NAME=CORE API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / Supabase connection string
# Local Docker default:
DATABASE_URL=postgresql+psycopg://core_user:core_password@localhost:5433/core_db
# Supabase (app, transaction pooler, rol core_app; lo escribe scripts/provision_app_role.py):
# DATABASE_URL=postgresql+psycopg://core_app.riajvipcxkgljtncqcwj:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase (Alembic, session pooler o conexión directa). Si se omite, usa DATABASE_URL:
# DATABASE_URL_MIGRATIONS=postgresql+psycopg://postgres.riajvipcxkgljtncqcwj:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3011"]
